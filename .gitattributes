# Нормализация окончаний строк — чтобы файлы не показывались как изменённые без правок
* text=auto

# Исходники — явно LF в репозитории (на Windows при checkout может быть CRLF, но коммит всегда LF)
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf

# Бинарники не трогать
*.jar binary
*.war binary
*.png binary
*.ico binary
