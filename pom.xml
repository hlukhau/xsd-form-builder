<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.eec</groupId>
    <artifactId>xsd-form-builder</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>XSD Form Builder</name>
    <description>Frontend application for visualizing Dangerous Product Alert Details card</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <java.version>1.8</java.version>
        <tomcat.version>8.5.23</tomcat.version>
        <servlet-api.version>3.1.0</servlet-api.version>
        <node.version>v18.17.0</node.version>
        <npm.version>9.6.7</npm.version>
    </properties>

    <dependencies>
        <!-- Servlet API для компиляции Java сервлетов -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>${servlet-api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Oracle JDBC Driver -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc8</artifactId>
            <version>21.9.0.0</version>
        </dependency>

        <!-- Зависимости не нужны - используем простой JSON через PrintWriter -->
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- Maven Compiler Plugin для Java 8 - старая версия, которая может быть в локальном репозитории -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Frontend Maven Plugin отключен из-за проблем с SSL -->
            <!-- React приложение должно быть собрано вручную: npm run build -->
            <!-- После сборки файлы будут в папке dist/ -->


            <!-- Maven WAR Plugin для упаковки в WAR - старая версия, которая может быть в локальном репозитории -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>2.6</version>
                <configuration>
                    <warSourceDirectory>src/main/webapp</warSourceDirectory>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <!-- Убираем packagingIncludes чтобы включить все зависимости -->
                    <webResources>
                        <resource>
                            <directory>dist</directory>
                            <targetPath>/</targetPath>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>

            <!-- Maven Clean Plugin - убираем, используем стандартный -->
        </plugins>
    </build>
</project>
