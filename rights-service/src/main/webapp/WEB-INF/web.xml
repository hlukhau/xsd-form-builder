<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1" metadata-complete="true">

  <display-name>eec-rights-service</display-name>

  <context-param>
    <param-name>app.security.api-key</param-name>
    <param-value></param-value>
  </context-param>

  <filter>
    <filter-name>ApiKeyFilter</filter-name>
    <filter-class>com.eec.rights.ApiKeyFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>ApiKeyFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>HealthServlet</servlet-name>
    <servlet-class>com.eec.rights.HealthServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>HealthServlet</servlet-name>
    <url-pattern>/health</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>RightsApiServlet</servlet-name>
    <servlet-class>com.eec.rights.RightsApiServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>RightsApiServlet</servlet-name>
    <url-pattern>/api/rights</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>RightsApiServlet</servlet-name>
    <url-pattern>/api/rights/*</url-pattern>
  </servlet-mapping>
</web-app>
