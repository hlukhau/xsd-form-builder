    <!-- Должен быть ПЕРЕД SpaServlet, чтобы обрабатывать API запросы первым -->
    <servlet>
        <servlet-name>XsdFormBuilderServlet</servlet-name>
        <servlet-class>com.eec.servlet.XsdFormBuilderServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
