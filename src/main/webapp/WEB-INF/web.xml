<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="false">

    <display-name>XSD Form Builder</display-name>
    <description>Frontend application for visualizing Dangerous Product Alert Details card</description>

    <!-- Кодировка по умолчанию -->
    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>

    <!-- Welcome file -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- MIME типы для статических ресурсов -->
    <mime-mapping>
        <extension>js</extension>
        <mime-type>application/javascript</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>css</extension>
        <mime-type>text/css</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>json</extension>
        <mime-type>application/json</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>xml</extension>
        <mime-type>application/xml</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>svg</extension>
        <mime-type>image/svg+xml</mime-type>
    </mime-mapping>

    <!-- Настройки сессии -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Обработка ошибок -->
    <!-- Убираем error-page для 404, чтобы не вызывать рекурсию через SpaServlet -->
    <error-page>
        <error-code>500</error-code>
        <location>/index.html</location>
    </error-page>

    <!-- Listener для инициализации справочников при старте -->
    <listener>
        <listener-class>com.eec.servlet.DictionaryInitializerListener</listener-class>
    </listener>

    <!-- Тестовый сервлет для проверки деплоя -->
    <servlet>
        <servlet-name>TestServlet</servlet-name>
        <servlet-class>com.eec.servlet.TestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TestServlet</servlet-name>
        <url-pattern>/test</url-pattern>
    </servlet-mapping>

    <!-- Регистрация сервлетов для API -->
    <servlet>
        <servlet-name>CountriesOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.CountriesOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CountriesOptionsServlet</servlet-name>
        <url-pattern>/api/countries/options</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CountryExistsServlet</servlet-name>
        <servlet-class>com.eec.servlet.CountryExistsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CountryExistsServlet</servlet-name>
        <!-- Используем паттерн /api/countries/* чтобы перехватить все запросы к /api/countries/... -->
        <!-- Сервлет сам определит, заканчивается ли путь на /exists -->
        <url-pattern>/api/countries/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>IncidentAlertKindOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.IncidentAlertKindOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IncidentAlertKindOptionsServlet</servlet-name>
        <url-pattern>/api/incident-alert-kinds/options</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AuthorityOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.AuthorityOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthorityOptionsServlet</servlet-name>
        <url-pattern>/api/authorities/options</url-pattern>
    </servlet-mapping>

    <!-- SPA Servlet для обработки маршрутизации (должен быть последним) -->
    <!-- НЕ используем паттерн / или /*, чтобы не перехватывать API запросы -->
    <!-- Используем error-page для 404, чтобы возвращать index.html для SPA routes -->
    <!-- SpaServlet будет обрабатывать только явные запросы к index.html -->
    <servlet>
        <servlet-name>SpaServlet</servlet-name>
        <servlet-class>com.eec.servlet.SpaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SpaServlet</servlet-name>
        <url-pattern>/index.html</url-pattern>
    </servlet-mapping>

</web-app>
