        <url-pattern>/*</url-pattern>
    </servlet-mapping>

    <!-- SPA Servlet для обработки маршрутизации -->
    <!-- Обрабатывает только явные запросы к index.html -->
    <!-- Остальные запросы обрабатываются XsdFormBuilderServlet, который передает их в SPA при необходимости -->
