<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="false">

    <display-name>XSD Form Builder</display-name>
    <description>Frontend application for visualizing Dangerous Product Alert Details card</description>

    <!-- eec-rights: тот же Tomcat, что и pha/dpa/ppv. Порт = HTTP Connector (conf/server.xml) или EEC_RIGHTS_SERVICE_BASE_URL -->
    <context-param>
        <param-name>eec.rights.service.baseUrl</param-name>
        <param-value>http://127.0.0.1:8083/card_rigths</param-value>
    </context-param>
    <context-param>
        <param-name>eec.rights.service.apiKey</param-name>
        <param-value></param-value>
    </context-param>

    <!-- Кодировка по умолчанию -->
    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>

    <!-- Welcome file -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- MIME типы для статических ресурсов -->
    <mime-mapping>
        <extension>js</extension>
        <mime-type>application/javascript</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>css</extension>
        <mime-type>text/css</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>json</extension>
        <mime-type>application/json</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>xml</extension>
        <mime-type>application/xml</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>svg</extension>
        <mime-type>image/svg+xml</mime-type>
    </mime-mapping>

    <!-- Настройки сессии -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Обработка ошибок: не маппим 500 на index.html — SpaServlet не обрабатывает ERROR-dispatch,
         из-за чего получается пустой ответ и повторные 500 в логе. -->

