<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="false">

    <display-name>XSD Form Builder</display-name>
    <description>Frontend application for visualizing Dangerous Product Alert Details card</description>

    <!-- Кодировка по умолчанию -->
    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>

    <!-- Welcome file -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- MIME типы для статических ресурсов -->
    <mime-mapping>
        <extension>js</extension>
        <mime-type>application/javascript</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>css</extension>
        <mime-type>text/css</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>json</extension>
        <mime-type>application/json</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>xml</extension>
        <mime-type>application/xml</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>svg</extension>
        <mime-type>image/svg+xml</mime-type>
    </mime-mapping>

    <!-- Настройки сессии -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Обработка ошибок -->
    <!-- Убираем error-page для 404, чтобы не вызывать рекурсию через SpaServlet -->
    <error-page>
        <error-code>500</error-code>
        <location>/index.html</location>
    </error-page>

    <!-- Listener для инициализации справочников при старте -->
    <listener>
        <listener-class>com.eec.servlet.DictionaryInitializerListener</listener-class>
    </listener>

    <!-- Тестовый сервлет для проверки деплоя -->
    <servlet>
        <servlet-name>TestServlet</servlet-name>
        <servlet-class>com.eec.servlet.TestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TestServlet</servlet-name>
        <url-pattern>/test</url-pattern>
    </servlet-mapping>

    <!-- Регистрация сервлетов для API -->
    <servlet>
        <servlet-name>CountriesOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.CountriesOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CountriesOptionsServlet</servlet-name>
        <url-pattern>/api/countries/options</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CountryExistsServlet</servlet-name>
        <servlet-class>com.eec.servlet.CountryExistsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CountryExistsServlet</servlet-name>
        <!-- Используем паттерн /api/countries/* чтобы перехватить все запросы к /api/countries/... -->
        <!-- Сервлет сам определит, заканчивается ли путь на /exists -->
        <url-pattern>/api/countries/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>IncidentAlertKindOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.IncidentAlertKindOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IncidentAlertKindOptionsServlet</servlet-name>
        <url-pattern>/api/incident-alert-kinds/options</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AuthorityOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.AuthorityOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthorityOptionsServlet</servlet-name>
        <url-pattern>/api/authorities/options</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SanitaryProdTypeOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.SanitaryProdTypeOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SanitaryProdTypeOptionsServlet</servlet-name>
        <url-pattern>/api/sanitary-prod-types/options</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MeasurementUnitOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.MeasurementUnitOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MeasurementUnitOptionsServlet</servlet-name>
        <url-pattern>/api/measurement-units/options</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ShipDocKindOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.ShipDocKindOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ShipDocKindOptionsServlet</servlet-name>
        <url-pattern>/api/ship-doc-kinds/options</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SupplyChainPartyKindOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.SupplyChainPartyKindOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SupplyChainPartyKindOptionsServlet</servlet-name>
        <url-pattern>/api/supply-chain-party-kinds/options</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TechRegulOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.TechRegulOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TechRegulOptionsServlet</servlet-name>
        <url-pattern>/api/tech-reguls/options</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SanitaryMeasureObjKindOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.SanitaryMeasureObjKindOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SanitaryMeasureObjKindOptionsServlet</servlet-name>
        <url-pattern>/api/sanitary-measure-obj-kinds/options</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SanitaryMeasureOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.SanitaryMeasureOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SanitaryMeasureOptionsServlet</servlet-name>
        <url-pattern>/api/sanitary-measures/options</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MediaTypeOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.MediaTypeOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MediaTypeOptionsServlet</servlet-name>
        <url-pattern>/api/media-types/options</url-pattern>
    </servlet-mapping>

    <!-- Проверка прав доступа (id — опциональный параметр запроса) -->
    <servlet>
        <servlet-name>AccessCheckServlet</servlet-name>
        <servlet-class>com.eec.servlet.AccessCheckServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccessCheckServlet</servlet-name>
        <url-pattern>/api/access/check</url-pattern>
    </servlet-mapping>

    <!-- XML по DPAID из таблицы DPAXML -->
    <servlet>
        <servlet-name>DpaXmlServlet</servlet-name>
        <servlet-class>com.eec.servlet.DpaXmlServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DpaXmlServlet</servlet-name>
        <url-pattern>/api/dpa/xml/*</url-pattern>
    </servlet-mapping>

    <!-- Метаданные карты из VW_DPA (GET /api/dpa/metadata/{DPAID}) -->
    <servlet>
        <servlet-name>DpaMetadataServlet</servlet-name>
        <servlet-class>com.eec.servlet.DpaMetadataServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DpaMetadataServlet</servlet-name>
        <url-pattern>/api/dpa/metadata/*</url-pattern>
    </servlet-mapping>

    <!-- История смены статусов из DPASTATUSHIST -->
    <servlet>
        <servlet-name>DpaStatusHistoryServlet</servlet-name>
        <servlet-class>com.eec.servlet.DpaStatusHistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DpaStatusHistoryServlet</servlet-name>
        <url-pattern>/api/dpa/status-history/*</url-pattern>
    </servlet-mapping>

    <!-- Электронные документы и запись общего ресурса по DPAID (EDOC + VW_PACKAGEMESSAGE) -->
    <servlet>
        <servlet-name>DpaElectronicDocsServlet</servlet-name>
        <servlet-class>com.eec.servlet.DpaElectronicDocsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DpaElectronicDocsServlet</servlet-name>
        <url-pattern>/api/dpa/electronic-docs/*</url-pattern>
    </servlet-mapping>

    <!-- Подразделения (SESDEV.TB_DEP) для выбора в «Определить доступ» -->
    <servlet>
        <servlet-name>DepOptionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.DepOptionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DepOptionsServlet</servlet-name>
        <url-pattern>/api/dep/options</url-pattern>
    </servlet-mapping>

    <!-- Доступ по DPAID: подразделения, связь SESINT.DPADEPPERMIS(DPAID, DEPID) -->
    <servlet>
        <servlet-name>DpaAccessServlet</servlet-name>
        <servlet-class>com.eec.servlet.DpaAccessServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DpaAccessServlet</servlet-name>
        <url-pattern>/api/dpa/access</url-pattern>
    </servlet-mapping>

    <!-- Смена статуса карты (входящие: Завершение обработки, Закрытие карты) -->
    <servlet>
        <servlet-name>DpaStatusChangeServlet</servlet-name>
        <servlet-class>com.eec.servlet.DpaStatusChangeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DpaStatusChangeServlet</servlet-name>
        <url-pattern>/api/dpa/status</url-pattern>
    </servlet-mapping>

    <!-- Следующий уникальный регистрационный номер для страны (при создании карты) -->
    <servlet>
        <servlet-name>DpaNextRegNumberServlet</servlet-name>
        <servlet-class>com.eec.servlet.DpaNextRegNumberServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DpaNextRegNumberServlet</servlet-name>
        <url-pattern>/api/dpa/next-registration-number</url-pattern>
    </servlet-mapping>

    <!-- Сохранение новой карты в DPA и DPAXML (исходящий, статус Черновик) -->
    <servlet>
        <servlet-name>DpaSaveServlet</servlet-name>
        <servlet-class>com.eec.servlet.DpaSaveServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DpaSaveServlet</servlet-name>
        <url-pattern>/api/dpa/save</url-pattern>
    </servlet-mapping>

    <!-- Удаление карты исходящих (только черновик, с проверкой права dangerousProductOut:edit по подразделениям DPADEPPERMIS) -->
    <servlet>
        <servlet-name>DpaDeleteServlet</servlet-name>
        <servlet-class>com.eec.servlet.DpaDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DpaDeleteServlet</servlet-name>
        <url-pattern>/api/dpa/delete</url-pattern>
    </servlet-mapping>

    <!-- Проверка возможности создания новой версии карты (кнопка «Сделать копию») -->
    <servlet>
        <servlet-name>DpaCanCreateNewVersionServlet</servlet-name>
        <servlet-class>com.eec.servlet.DpaCanCreateNewVersionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DpaCanCreateNewVersionServlet</servlet-name>
        <url-pattern>/api/dpa/can-create-new-version</url-pattern>
    </servlet-mapping>

    <!-- Текущий пользователь: уровень ЦГЭ (DEPKINDCODE, DEPKINDNAME) -->
    <servlet>
        <servlet-name>CurrentUserServlet</servlet-name>
        <servlet-class>com.eec.servlet.CurrentUserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CurrentUserServlet</servlet-name>
        <url-pattern>/api/current-user</url-pattern>
    </servlet-mapping>

    <!-- Список резолюций по карте (какие уровни уже наложили резолюцию) -->
    <servlet>
        <servlet-name>DpaResolutionsServlet</servlet-name>
        <servlet-class>com.eec.servlet.DpaResolutionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DpaResolutionsServlet</servlet-name>
        <url-pattern>/api/dpa/resolutions</url-pattern>
    </servlet-mapping>

    <!-- JSON прав по GUID (department.depid для «Определить доступ» по умолчанию) -->
    <servlet>
        <servlet-name>RightsServlet</servlet-name>
        <servlet-class>com.eec.servlet.RightsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RightsServlet</servlet-name>
        <url-pattern>/api/rights</url-pattern>
    </servlet-mapping>

    <!-- XSD Form Builder Servlet для работы с GUID и DPAID -->
    <!-- Обрабатывает только запросы формата /{DPAID}/{GUID} внутри контекста приложения -->
    <!-- Должен быть ПЕРЕД SpaServlet, чтобы обрабатывать API запросы первым -->
    <servlet>
        <servlet-name>XsdFormBuilderServlet</servlet-name>
        <servlet-class>com.eec.servlet.XsdFormBuilderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>XsdFormBuilderServlet</servlet-name>
        <url-pattern>/*</url-pattern>
    </servlet-mapping>

    <!-- SPA Servlet для обработки маршрутизации -->
    <!-- Обрабатывает только явные запросы к index.html -->
    <!-- Остальные запросы обрабатываются XsdFormBuilderServlet, который передает их в SPA при необходимости -->
    <servlet>
        <servlet-name>SpaServlet</servlet-name>
        <servlet-class>com.eec.servlet.SpaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SpaServlet</servlet-name>
        <url-pattern>/index.html</url-pattern>
    </servlet-mapping>

</web-app>
