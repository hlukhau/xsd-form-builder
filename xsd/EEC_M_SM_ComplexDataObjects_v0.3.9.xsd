        <xs:annotation>
            <xs:documentation>Информация об уникальном номере, присвоенном животному (группе животных) с указанием метода идентификации</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.CDT.00003: Сведения об идентификационном номере животного (Сведения об идентификационном номере животного_ Детали. Тип) -->
    <xs:complexType name="AnimalIdDetailsType">
        <xs:annotation>
            <xs:documentation>Компоненты, представляющие детализированную информацию об уникальном номере, присвоенном животному (группе животных) с указанием метода идентификации</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element ref="smsdo:AnimalId"/>
            <xs:element ref="smcdo:AnimalIdentificationMethodDetails"/>
            <xs:element ref="csdo:EventDate">
                <xs:annotation>
