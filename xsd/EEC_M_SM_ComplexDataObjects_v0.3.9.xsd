<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:EEC:M:BaseDataTypes:v0.4.12" xmlns:ccdo="urn:EEC:M:ComplexDataObjects:v0.4.12" xmlns:csdo="urn:EEC:M:SimpleDataObjects:v0.4.12" xmlns:smcdo="urn:EEC:M:SM:ComplexDataObjects:v0.3.9" xmlns:smsdo="urn:EEC:M:SM:SimpleDataObjects:v0.3.9" elementFormDefault="qualified" targetNamespace="urn:EEC:M:SM:ComplexDataObjects:v0.3.9" version="0.3.9">
    <xs:import namespace="urn:EEC:M:BaseDataTypes:v0.4.12" schemaLocation="EEC_M_BaseDataTypes_v0.4.12.xsd"/>
    <xs:import namespace="urn:EEC:M:SM:SimpleDataObjects:v0.3.9" schemaLocation="EEC_M_SM_SimpleDataObjects_v0.3.9.xsd"/>
    <xs:import namespace="urn:EEC:M:ComplexDataObjects:v0.4.12" schemaLocation="EEC_M_ComplexDataObjects_v0.4.12.xsd"/>
    <xs:import namespace="urn:EEC:M:SimpleDataObjects:v0.4.12" schemaLocation="EEC_M_SimpleDataObjects_v0.4.12.xsd"/>
    <!--M.SM.NSP.00002: - (-) -->
    <!-- M.SM.CDE.00089: Аттестат аккредитации (Аттестат аккредитации. Детали) -->
    <xs:element name="AccreditationCertificateDetails" type="smcdo:AccreditationCertificateDetailsType">
        <xs:annotation>
            <xs:documentation>Информация об аттестате аккредитации</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.CDT.00060: Структура сведений об аттестате аккредитации (Аттестат аккредитации_ Детали. Тип) -->
    <xs:complexType name="AccreditationCertificateDetailsType">
        <xs:annotation>
            <xs:documentation>Компоненты, представляющие детализированную информацию об аттестате аккредитации</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element ref="csdo:DocKindName"/>
            <xs:element ref="csdo:DocId"/>
            <xs:element minOccurs="0" ref="csdo:DocStartDate">
                <xs:annotation>
                    <xs:documentation>Дата начала срока действия документа</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="csdo:EventDate">
                <xs:annotation>
                    <xs:documentation>Дата регистрации аттестата аккредитации в Едином реестре</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="csdo:DocValidityDate">
                <xs:annotation>
                    <xs:documentation>Дата истечения срока действия документа</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <!-- M.SM.CDE.00108: Действующее вещество (Действующее вещество. Детали) -->
    <xs:element name="ActiveIngredientDetails" type="smcdo:ActiveIngredientDetailsType">
        <xs:annotation>
            <xs:documentation>Сведения о веществе биологического, биотехнологического, минерального или химического происхождения в составе ветеринарного лекарственного препарата, с действием которого на организм связывают эффективность данного препарата</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.CDT.00089: Структура сведений о действующем веществе (Действующее вещество_ Детали. Тип) -->
    <xs:complexType name="ActiveIngredientDetailsType">
        <xs:annotation>
            <xs:documentation>Компоненты, представляющие детализированную информацию о веществе биологического, биотехнологического, минерального или химического происхождения в составе ветеринарного лекарственного препарата, с действием которого на организм связывают эффективность данного препарата</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" ref="smsdo:ActiveIngredientCode">
                <xs:annotation>
                    <xs:documentation>Код действующего вещества в составе ветеринарного препарата</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="smsdo:ActiveIngredientName">
                <xs:annotation>
                    <xs:documentation>Наименование действующего вещества в составе ветеринарного препарата</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="unbounded" minOccurs="0" ref="smsdo:SubstanceMeasure">
                <xs:annotation>
                    <xs:documentation>Количество действующего вещества, выраженное в единицах массы, объемных или условных (биологических) единицах</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <!-- M.SM.CDE.00161: Субъект семеноводства (Субъект семеноводства. Детали) -->
    <xs:element name="AgriculturalOrganizationDetails" type="smcdo:AgriculturalOrganizationDetailsType">
        <xs:annotation>
            <xs:documentation>Сведения о субъекте семеноводства</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.CDT.00127: Субъект семеноводства (Субъект семеноводства_ Детали. Тип) -->
    <xs:complexType name="AgriculturalOrganizationDetailsType">
        <xs:annotation>
            <xs:documentation>Сведения о субъекте семеноводства</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element maxOccurs="unbounded" ref="smsdo:VarietySubjectTypeCode"/>
            <xs:element minOccurs="0" ref="smsdo:AgriculturalOrganizationCode"/>
            <xs:element minOccurs="0" ref="smsdo:AgriculturalOrganizationName"/>
            <xs:element maxOccurs="unbounded" ref="ccdo:SubjectAddressDetails"/>
            <xs:element maxOccurs="unbounded" minOccurs="0" ref="ccdo:CommunicationDetails"/>
        </xs:sequence>
    </xs:complexType>
    <!-- M.SM.CDE.00410: Сведения из справочника зон допуска (Сведения из справочника зон допуска. Детали) -->
    <xs:element name="AllowanceAreaClassifierDetails" type="smcdo:AllowanceAreaClassifierDetailsType">
        <xs:annotation>
            <xs:documentation>Определяется правилами формирования вложенных реквизитов</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.CDT.00410: Сведения из справочника зон допуска (Сведения из справочника зон допуска_ Детали. Тип) -->
    <xs:complexType name="AllowanceAreaClassifierDetailsType">
        <xs:annotation>
            <xs:documentation>Определяется областями значений вложенных реквизитов</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element ref="smsdo:AllowanceAreaCode">
                <xs:annotation>
                    <xs:documentation>Кодовое обозначение формируется с использованием серийно-порядкового метода кодирования</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element ref="smsdo:AllowanceAreaName">
                <xs:annotation>
                    <xs:documentation>Формируется в виде словосочетания на русском языке</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="unbounded" minOccurs="0" ref="smsdo:AllowanceRegionName">
                <xs:annotation>
                    <xs:documentation>Формируется в виде словосочетания на русском языке</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element ref="ccdo:CodeListItemDetails">
                <xs:annotation>
                    <xs:documentation>Определяется правилами формирования вложенных реквизитов</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <!-- M.SM.CDE.00158: Сведения о зоне допуска или световой зоне (Зона допуска или световая зона. Детали) -->
    <xs:element name="AllowanceAreaDetails" type="smcdo:AllowanceAreaDetailsType">
        <xs:annotation>
            <xs:documentation>сведения о части территории государства-члена, указанной в национальном реестре, характеризующейся определенной величиной притока естественной фотосинтетически активной радиации, или на которой сорт допущен (разрешен, рекомендован) к использованию</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.CDT.00133: Зона допуска или световая зона (Зона допуска или световая зона_ Детали. Тип) -->
    <xs:complexType name="AllowanceAreaDetailsType">
        <xs:annotation>
            <xs:documentation>Компоненты, представляющие детализированную информацию о части территории государства-члена, указанной в национальном реестре, характеризующейся определенной величиной притока естественной фотосинтетически активной радиации, или на которой сорт допущен (разрешен, рекомендован) к использованию</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" ref="smsdo:AllowanceAreaCode">
                <xs:annotation>
                    <xs:documentation>кодовое обозначение зоны допуска или световой зоны </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="smsdo:AllowanceAreaName">
                <xs:annotation>
                    <xs:documentation>наименование зоны допуска или световой зоны</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <!-- M.SM.CDE.00302: Сведения о рождении животного (группы животных) (Сведения о рождении животного (группы животных). Детали) -->
    <xs:element name="AnimalBirthDetails" type="smcdo:AnimalBirthDetailsType">
        <xs:annotation>
            <xs:documentation>Информация о дате и месте рождения животного (группы животных)</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.CDT.00302: Сведения о рождении животного (группы животных) (Сведения о рождении животного (группы животных)_ Детали. Тип) -->
    <xs:complexType name="AnimalBirthDetailsType">
        <xs:annotation>
            <xs:documentation>Компоненты, представляющие детализированную информацию о рождении животного (группы животных)</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" ref="csdo:BirthDate">
                <xs:annotation>
                    <xs:documentation>Дата рождения животного</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="smcdo:AnimalBirthIntervalDetails"/>
            <xs:element ref="smcdo:AnimalLivestockFacilityDetails">
                <xs:annotation>
                    <xs:documentation>Информация о месте рождения животного</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <!-- M.SM.CDE.00303: Сведения об интервале дат рождения группы животных (Интервал дат рождения группы животных. Детали) -->
    <xs:element name="AnimalBirthIntervalDetails" type="smcdo:AnimalBirthIntervalDetailsType">
        <xs:annotation>
            <xs:documentation>Информация об интервале дат рождения группы животных</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.CDT.00303: Интервал дат рождения группы животных (Интервал дат рождения группы животных_ Детали. Тип) -->
    <xs:complexType name="AnimalBirthIntervalDetailsType">
        <xs:annotation>
            <xs:documentation>Компоненты, представляющие детализированную информацию об интервале дат рождения группы животных</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element ref="csdo:StartDate">
                <xs:annotation>
                    <xs:documentation>Начальная дата периода рождения группы животных</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element ref="csdo:EndDate">
                <xs:annotation>
                    <xs:documentation>Конечная дата периода рождения группы животных</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <!-- M.SM.CDE.00310: Сведения об убое или гибели животного (группы животных) (Сведения об убое или гибели животного (группы животных). Детали) -->
    <xs:element name="AnimalDeathDetails" type="smcdo:AnimalDeathDetailsType">
        <xs:annotation>
            <xs:documentation>Информация об убое или гибели (падеже) животного (группы животных)</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.CDT.00310: Сведения об убое или гибели животного (группы животных) (Сведения об убое или гибели животного (группы животных)_ Детали. Тип) -->
    <xs:complexType name="AnimalDeathDetailsType">
        <xs:annotation>
            <xs:documentation>Компоненты, представляющие детализированную информацию об убое или гибели (падеже) животного (группы животных)</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element ref="smsdo:AnimalSlaughterIndicator"/>
            <xs:element ref="csdo:EventDate">
                <xs:annotation>
                    <xs:documentation>Дата убоя или гибели (падежа) животного</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element ref="smcdo:AnimalLivestockFacilityDetails">
                <xs:annotation>
                    <xs:documentation>Информация о месте убоя или гибели (падежа) животного</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="csdo:AdditionalInfoText">
                <xs:annotation>
                    <xs:documentation>Дополнительная информация об убое или гибели (падеже) животного</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <!-- M.SM.CDE.00001: Животное (Животное. Детали) -->
    <xs:element name="AnimalDetails" type="smcdo:AnimalDetailsType">
        <xs:annotation>
            <xs:documentation>Информация о животном (группе животных)</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.CDT.00001: Структура сведений о животном (Сведения о животном_ Детали. Тип) -->
    <xs:complexType name="AnimalDetailsType">
        <xs:annotation>
            <xs:documentation>Компоненты, представляющие детализированную информацию о животном (группе животных)</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" ref="smsdo:AnimalQuantity">
                <xs:annotation>
                    <xs:documentation>Количество животных в группе</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element ref="smcdo:AnimalProductKindDetails"/>
            <xs:element minOccurs="0" ref="csdo:UnifiedSexCode">
                <xs:annotation>
                    <xs:documentation>Биологический пол животного</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="smsdo:AnimalName"/>
            <xs:element minOccurs="0" ref="smsdo:AnimalBreedName"/>
            <xs:element minOccurs="0" ref="smsdo:AnimalColorName"/>
            <xs:element minOccurs="0" ref="csdo:UnifiedMassMeasure">
                <xs:annotation>
                    <xs:documentation>Масса животного</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="csdo:DescriptionText">
                <xs:annotation>
                    <xs:documentation>Описание животного</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="smsdo:AnimalDistinguishingMarksText"/>
            <xs:element minOccurs="0" ref="smcdo:AnimalPedigreeDetails"/>
            <xs:element minOccurs="0" ref="smsdo:AnimalPicture"/>
            <xs:element minOccurs="0" ref="smcdo:AnimalBirthDetails"/>
            <xs:element minOccurs="0" ref="smcdo:AnimalLivestockFacilityDetails">
                <xs:annotation>
                    <xs:documentation>Информация о месте содержания животного (животноводческом объекте)</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="smcdo:AnimalDeathDetails"/>
            <xs:element maxOccurs="unbounded" minOccurs="0" ref="smcdo:AnimalVeterinaryEventDetails"/>
        </xs:sequence>
    </xs:complexType>
    <!-- M.SM.CDE.00139: Болезнь животного (Болезнь животного. Детали) -->
    <xs:element name="AnimalDiseaseDetails" type="smcdo:AnimalDiseaseDetailsType">
        <xs:annotation>
            <xs:documentation>Информация о болезни животного</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.CDT.00117: Структура сведений о болезни животного (Болезнь животного_ Детали. Тип) -->
    <xs:complexType name="AnimalDiseaseDetailsType">
        <xs:annotation>
            <xs:documentation>Компоненты, представляющие детализированную информацию о болезни животного</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" ref="smsdo:AnimalDiseaseCode"/>
            <xs:element minOccurs="0" ref="smsdo:AnimalDiseaseName"/>
            <xs:element minOccurs="0" ref="smcdo:PathogenDetails">
                <xs:annotation>
                    <xs:documentation>Название и тип возбудителя</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="unbounded" minOccurs="0" ref="smsdo:ClinicalSignText"/>
        </xs:sequence>
    </xs:complexType>
    <!-- M.SM.CDE.00020: Сообщение об обнаружении эпизоотического очага и мерах по его ликвидации (Сообщение об обнаружении эпизоотического очага. Детали) -->
    <xs:element name="AnimalDiseaseOutbreakAlertDetails" type="smcdo:AnimalDiseaseOutbreakAlertDetailsType">
        <xs:annotation>
            <xs:documentation>информация о случае обнаружения и распространения на территории государства-члена заразных болезней животных, в том числе общих для человека и животных, и о мерах по ликвидации эпизоотического очага</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.CDT.00954: Сообщение об обнаружении эпизоотического очага и мерах по его ликвидации (Сообщение об обнаружении эпизоотического очага_ Детали. Тип) -->
    <xs:complexType name="AnimalDiseaseOutbreakAlertDetailsType">
        <xs:annotation>
            <xs:documentation>Компоненты, представляющие детализированную информацию о случае обнаружения и распространения на территории государства-члена заразных болезней животных, в том числе общих для человека и животных, и о мерах по ликвидации эпизоотического очага</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element ref="smcdo:IncidentAlertIdDetails">
                <xs:annotation>
                    <xs:documentation>идентификатор уведомления об обнаружении эпизоотического очага и мерах по его ликвидации</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="smcdo:OutbreakLocationDetails"/>
            <xs:element minOccurs="0" ref="smsdo:RecurringOutbreakIndicator"/>
            <xs:element minOccurs="0" ref="smcdo:AnimalDiseaseDetails"/>
            <xs:element minOccurs="0" ref="csdo:StartDate">
                <xs:annotation>
                    <xs:documentation>Дата начала регистрации эпизоотического очага</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="csdo:EndDate">
                <xs:annotation>
                    <xs:documentation>Дата снятия ограничения</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="unbounded" minOccurs="0" ref="smcdo:SusceptibleAnimalsMeasureDetails"/>
            <xs:element maxOccurs="unbounded" minOccurs="0" ref="smcdo:ControlMeasureDetails"/>
            <xs:element minOccurs="0" ref="smcdo:EpizooticInvestigationDetails"/>
            <xs:element maxOccurs="unbounded" minOccurs="0" ref="smcdo:LaboratoryDiseaseConfirmationDetails">
                <xs:annotation>
                    <xs:documentation>сведения о лабораторном исследовании животного (группы животных), подтверждающем наличие или отсутствие болезни</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="ccdo:OfficerDetails">
                <xs:annotation>
                    <xs:documentation>Сведения о должностном лице, сформировавшем сообщение</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="ccdo:SubjectAddressDetails">
                <xs:annotation>
                    <xs:documentation>Сведения об адресе должностного лица, сформировавшего сообщение</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element ref="ccdo:ResourceItemStatusDetails"/>
        </xs:sequence>
    </xs:complexType>
