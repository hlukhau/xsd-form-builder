    <xs:element name="AllAreasAllowanceIndicator" type="bdt:IndicatorType">
        <xs:annotation>
            <xs:documentation>признак, определяющий допуск (разрешение, рекомендацию) сорта к использованию во всех зонах допуска или световых зонах государства-члена: 1 – сорт допущен (разрешен, рекомендован) к использованию во всех зонах допуска или световых зонах; 0 – сорт допущен (разрешен, рекомендован) к использованию не во всех зонах допуска или световых зонах</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.SDE.00415: Код зоны допуска или световой зоны (Зона допуска или световая зона. Код) -->
    <xs:element name="AllowanceAreaCode" type="smsdo:AllowanceAreaCodeType">
        <xs:annotation>
            <xs:documentation>Кодовое обозначение части территории государства-члена, указанной в национальном реестре, характеризующейся определенной величиной притока естественной фотосинтетически активной радиации, или на которой сорт допущен (разрешен, рекомендован) к использованию</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.SDT.00405: Зона допуска или световая зона (Зона допуска или световая зона_ Код. Тип) -->
