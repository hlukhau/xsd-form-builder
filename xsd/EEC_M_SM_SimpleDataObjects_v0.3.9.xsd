    <xs:element name="AdditionalDeclarationText" type="smsdo:LocalizedText4000Type">
        <xs:annotation>
            <xs:documentation>Текст дополнительной декларации</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.SDE.00138: Запрос дополнительной информации (Запрос дополнительной информации. Текст) -->
    <xs:element name="AdditionalInfoRequestText" type="csdo:Text4000Type">
        <xs:annotation>
            <xs:documentation>Текст запроса дополнительной информации о временной карантинной фитосанитарной мере</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.SDE.00203: Признак гарантий, основанных на дополнительном досмотре (Признак гарантий, основанных на дополнительном досмотре. Индикатор) -->
    <xs:element name="AdditionalInspectionGuaranteeIndicator" type="bdt:IndicatorType">
        <xs:annotation>
            <xs:documentation>Признак, определяющий факт того, что гарантии основаны на дополнительном досмотре: 1 – основаны; 0 – не основаны</xs:documentation>
        </xs:annotation>
    </xs:element>
