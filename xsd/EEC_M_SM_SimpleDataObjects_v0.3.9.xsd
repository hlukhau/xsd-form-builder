    <!-- M.SM.SDE.00065: Код действующего вещества (Действующее вещество. Код) -->
    <xs:element name="ActiveIngredientCode" type="smsdo:ActiveIngredientCodeType">
        <xs:annotation>
            <xs:documentation>Кодовое обозначение вещества биологического, биотехнологического, минерального или химического происхождения в составе ветеринарного лекарственного препарата, с действием которого на организм связывают эффективность данного препарата</xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- M.SM.SDT.00025: Код действующего вещества (Вид действующего вещества_ Код. Тип) -->
    <xs:simpleType name="ActiveIngredientCodeType">
        <xs:annotation>
            <xs:documentation>Строка символов, представляющая краткое условное обозначение вещества биологического, биотехнологического, минерального или химического происхождения в составе ветеринарного лекарственного препарата, с действием которого на организм связывают эффективность данного препарата</xs:documentation>
        </xs:annotation>
        <xs:restriction base="bdt:CodeType">
            <xs:pattern value="[0-9]{5}"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- M.SM.SDE.00081: Наименование действующего вещества (Действующее вещество. Имя) -->
    <xs:element name="ActiveIngredientName" type="csdo:Name500Type">
        <xs:annotation>
            <xs:documentation>Наименование вещества биологического, биотехнологического, минерального или химического происхождения в составе ветеринарного лекарственного препарата, с действием которого на организм связывают эффективность данного препарата</xs:documentation>
        </xs:annotation>
    </xs:element>
