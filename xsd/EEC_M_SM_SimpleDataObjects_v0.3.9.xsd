        <xs:annotation>
            <xs:documentation>Строка символов, представляющая краткое условное обозначение региона, в котором сорт допущен к использованию</xs:documentation>
        </xs:annotation>
        <xs:restriction base="bdt:CodeType"/>
    </xs:simpleType>
    <!-- M.SM.SDE.00413: Наименование зоны допуска или световой зоны (Зона допуска или световая зона. Имя) -->
