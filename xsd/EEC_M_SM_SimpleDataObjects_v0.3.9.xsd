        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="csdo:Name120Type">
                <xs:attribute default="0" name="lightAreaNameIndicator" type="bdt:IndicatorType">
                    <xs:annotation>
                        <xs:documentation>признак, определяющий вид зоны, чье название передается в реквизите: 1 – в реквизите передается имя световой зоны; 0 (значение по умолчанию) – в реквизите передается имя зоны допуска</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
